{
  "name": "@taleland/outbox-mikro-orm",
  "version": "1.0.0",
  "description": "MikroORM PostgreSQL storage strategy for the Taleland transactional outbox.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taleland/outbox.git",
    "directory": "packages/mikro-orm"
  },
  "homepage": "https://github.com/taleland/outbox#readme",
  "bugs": {
    "url": "https://github.com/taleland/outbox/issues"
  },
  "publishConfig": {
