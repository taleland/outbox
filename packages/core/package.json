{
  "name": "@taleland/outbox-core",
  "version": "1.0.0",
  "description": "ORM-independent transactional outbox with pluggable storage and publication.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taleland/outbox.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/taleland/outbox#readme",
  "bugs": {
    "url": "https://github.com/taleland/outbox/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test:unit": "node --test dist/test/*.test.js"
  }
}
