{
  "name": "@taleland/outbox-nestjs",
  "version": "1.0.0",
  "description": "NestJS module for the Taleland transactional outbox with pluggable storage and publishers.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taleland/outbox.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/taleland/outbox#readme",
  "bugs": {
    "url": "https://github.com/taleland/outbox/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test:unit": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@taleland/outbox-core": "^1.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/schedule": "^12.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/testing": "12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
